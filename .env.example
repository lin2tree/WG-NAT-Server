# FCloud 环境配置文件示例
# 复制此文件为 .env 并修改实际值

# ==================== 服务器配置 ====================
# 服务器IP地址（用于前端API请求）
SERVER_IP=your_server_ip_here

# 端口配置
FRONTEND_PORT=80
BACKEND_PORT=8000

# ==================== 数据库配置 ====================
DB_PASSWORD=your_secure_db_password_here

# ==================== 认证配置 ====================

# 默认管理员账户配置
# 注意：首次部署时创建默认管理员，之后修改此处不会影响已创建的用户
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your_admin_password_here

# VM Token - VM访问后端API时使用
# 注意：此Token与第三方应用Token完全独立，不可互换
VM_TOKEN=your_vm_token_here

# 第三方应用Token - 第三方应用访问后端API时使用
# 注意：此Token与VM Token完全独立，不可互换
THIRD_PARTY_TOKEN=your_third_party_token_here

# JWT密钥 - 浏览器管理员登录后获取的Token使用此密钥签名
# 生产环境请修改为随机字符串
ADMIN_JWT_SECRET=your_jwt_secret_key_here

# JWT过期时间（小时）
ADMIN_JWT_EXPIRE_HOURS=24

# ==================== WireGuard配置 ====================
# WireGuard公网IP（客户端连接地址）
PUBLIC_IP=your_public_ip_here

# WireGuard VPN子网前缀（完整子网为 {WIREGUARD_VPN_SUBNET}.C.D，其中C.D来自VM IP）
WIREGUARD_VPN_SUBNET=10

# WireGuard服务器监听端口
WIREGUARD_SERVER_PORT=2588

# 每个VM生成的客户端配置数量
WIREGUARD_CLIENT_COUNT=6

# WireGuard Keepalive间隔（秒）
WIREGUARD_KEEPALIVE=25

# ==================== 日志配置 ====================
# 日志级别
LOG_LEVEL=INFO

# 日志保留天数（超过此天数的日志将被自动清理）
LOG_RETENTION_DAYS=90

# ==================== 前端配置 ====================
# 数据自动刷新间隔（毫秒），0表示禁用自动刷新
VITE_REFRESH_INTERVAL=5000

# ==================== Token说明 ====================
# 
# 系统使用三种不同的Token：
#
# 1. VM Token (VM_TOKEN)
#    - 用途：VM访问后端API (/api/vm/*)
#    - 格式：简单字符串
#    - 认证方式：Token + TCP层IP验证
#    - 安全：直接从TCP连接获取VM真实IP，防止IP伪造
#
# 2. 第三方应用Token (THIRD_PARTY_TOKEN)
#    - 用途：第三方应用访问后端API (/api/3rd/*)
#    - 格式：简单字符串
#    - 认证方式：Token验证
#
# 3. JWT Token
#    - 用途：浏览器管理员访问API (/api/admin/*, /api/auth/*)
#    - 格式：JWT (JSON Web Token)
#    - 获取方式：通过 /api/auth/login 登录获取
#    - 认证方式：Token签名验证 + 用户权限检查
#
# 重要：三种Token不可互换使用！
